FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN mkdir -p /state && chown 10001:10001 /state
COPY --chown=10001:10001 inference/__init__.py inference/storage.py inference/operations.py /app/inference/
USER 10001:10001
ENTRYPOINT ["python", "-m", "inference.operations"]
